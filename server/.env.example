# ─────────────────────────────────────────────
#  Éditions Alfa — server configuration
#  Fill in the empty values, then run: npm run seed
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Where the React app runs (comma-separate several origins)
CLIENT_URL=http://localhost:5173

# MongoDB connection string (MongoDB Atlas or local)
# e.g. mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/editions-alfa
MONGODB_URI=

# Long random string used to sign admin sessions
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=editions-alfa

# First admin account (created automatically on first start if no admin exists)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
